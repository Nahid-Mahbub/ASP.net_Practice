@model IEnumerable<DevSkill.Shop.Domain.Entities.Stock>

@{
    ViewData["Title"] = "Stocks";
}

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<!-- DataTables Bootstrap 5 -->
<link rel="stylesheet" href="https://cdn.datatables.net/2.3.2/css/dataTables.bootstrap5.css">
<link rel="stylesheet" href="https://cdn.datatables.net/responsive/3.0.2/css/responsive.bootstrap5.css">

<style>
    body {
        background: #f5f7fb;
    }

    .card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 8px 20px rgba(0,0,0,.08);
    }

    .card-header {
        border-radius: 15px 15px 0 0 !important;
        padding: 18px 25px;
    }

    .table tbody tr {
        transition: .25s;
    }

        .table tbody tr:hover {
            background: #f8f9fa;
        }

    .badge-qty {
        background: #198754;
        color: white;
        font-size: .9rem;
        padding: .55rem .8rem;
    }

    .badge-low {
        background: #dc3545;
        color: white;
        font-size: .9rem;
        padding: .55rem .8rem;
    }

    .btn {
        border-radius: 8px;
    }

    .dataTables_wrapper .dataTables_filter,
    .dataTables_wrapper .dataTables_length {
        margin-bottom: 15px;
    }

        .dataTables_wrapper .dataTables_filter input,
        .dataTables_wrapper .dataTables_length select {
            border-radius: 8px;
        }

    .dataTables_wrapper .dataTables_info {
        padding-top: 15px;
    }
</style>

<div class="container-fluid mt-4">

    <div class="card">

        <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">

            <div>
                <h3 class="mb-0">
                    <i class="bi bi-boxes"></i>
                    Stock Management
                </h3>
                <small>Manage inventory and stock levels</small>
            </div>

            <a asp-action="Create" class="btn btn-light">
                <i class="bi bi-plus-circle-fill"></i>
                Add Stock
            </a>

        </div>

        <div class="card-body">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="bi bi-check-circle-fill"></i>
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <table id="stockTable" class="table table-striped table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Product ID</th>
                        <th>Quantity</th>
                        <th>Low Stock</th>
                        <th width="170">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <strong class="text-primary">
                                        #@item.ProductId
                                    </strong>
                                </td>

                                <td>
                                    <span class="badge badge-qty">
                                        @item.Quantity
                                    </span>
                                </td>

                                <td>
                                    @if (item.Quantity <= item.LowStockQuantity)
                                    {
                                        <span class="badge badge-low">
                                            @item.LowStockQuantity
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @item.LowStockQuantity
                                        </span>
                                    }
                                </td>

                                <td>

                                    <div class="btn-group">

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-warning btn-sm">

                                            <i class="bi bi-pencil-square"></i>

                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-danger btn-sm">

                                            <i class="bi bi-trash"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5">

                                <i class="bi bi-box display-1 text-secondary"></i>

                                <h5 class="mt-3 text-muted">
                                    No Stock Records Found
                                </h5>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts
{
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdn.datatables.net/2.3.2/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/2.3.2/js/dataTables.bootstrap5.js"></script>

    <script src="https://cdn.datatables.net/responsive/3.0.2/js/dataTables.responsive.js"></script>
    <script src="https://cdn.datatables.net/responsive/3.0.2/js/responsive.bootstrap5.js"></script>

    <script>
        $(function() {

            $('#stockTable').DataTable({

                responsive: true,
                pageLength: 10,

                lengthMenu: [
                    [10, 25, 50, 100],
                    [10, 25, 50, 100]
                ],

                language: {
                    search: "",
                    searchPlaceholder: "🔍 Search stock...",
                    lengthMenu: "Show _MENU_ records",
                    info: "Showing _START_ to _END_ of _TOTAL_ records",
                    paginate: {
                        previous: "←",
                        next: "→"
                    }
                }

            });

        });
    </script>
}