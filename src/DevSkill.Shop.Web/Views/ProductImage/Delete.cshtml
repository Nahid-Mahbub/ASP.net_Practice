@model DevSkill.Shop.Domain.Entities.ProductImage

@{
    ViewData["Title"] = "Delete Product Image";
}

<h2>Delete Product Image</h2>

<div class="alert alert-warning">
    Are you sure you want to delete this image?
</div>

<div class="mb-3">
    <img src="~/images/products/@Model.ImageName"
         width="200"
         class="img-thumbnail" />
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index"
       asp-route-productId="@Model.ProductId"
       class="btn btn-secondary">
        Cancel
    </a>
</form>