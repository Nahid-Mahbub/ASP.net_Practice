@model DevSkill.Shop.Web.Models.ProductImageIndexModel

@{
    ViewData["Title"] = "Product Images";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">


<style>

    body {
        background: #f5f7fb;
    }

    .card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 8px 20px rgba(0,0,0,.08);
    }

    .card-header {
        border-radius: 15px 15px 0 0 !important;
        padding: 18px 25px;
    }

    .image-card {
        border-radius: 15px;
        overflow: hidden;
        transition: .3s;
        border: 1px solid #eee;
        background: white;
    }

        .image-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0,0,0,.15);
        }

    .product-image {
        width: 100%;
        height: 220px;
        object-fit: cover;
    }

    .image-name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .btn {
        border-radius: 8px;
    }

</style>




<div class="container-fluid mt-4">


    <div class="card">


        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">


            <div>

                <h3 class="mb-0">

                    <i class="bi bi-images"></i>
                    Product Images

                </h3>


                <small>
                    Select product and manage images
                </small>


            </div>




            <div>


                @if (Model.SelectedProductId > 0)
                {

                    <a asp-action="Create"
                       asp-route-productId="@Model.SelectedProductId"
                       class="btn btn-light">

                        <i class="bi bi-plus-circle-fill"></i>
                        Add New Picture

                    </a>

                }



                <a asp-controller="Products"
                   asp-action="Index"
                   class="btn btn-dark">

                    <i class="bi bi-arrow-left"></i>
                    Products

                </a>


            </div>


        </div>





        <div class="card-body">



            @if (TempData["Success"] != null)
            {

                <div class="alert alert-success alert-dismissible fade show">

                    <i class="bi bi-check-circle-fill"></i>

                    @TempData["Success"]


                    <button class="btn-close"
                            data-bs-dismiss="alert">
                    </button>


                </div>

            }





            @if (TempData["Error"] != null)
            {

                <div class="alert alert-danger alert-dismissible fade show">


                    <i class="bi bi-exclamation-triangle-fill"></i>

                    @TempData["Error"]


                    <button class="btn-close"
                            data-bs-dismiss="alert">
                    </button>


                </div>

            }






            <div class="row mb-4">


                <div class="col-md-6">



                    <form asp-action="Index" method="get">



                        <label class="form-label fw-bold">

                            Select Product

                        </label>




                        <div class="input-group">



                            <select name="productId"
                                    class="form-select">


                                <option value="0">

                                    -- Select Product --

                                </option>



                                @foreach (var product in Model.Products)
                                {

                                    <option value="@product.Value"
                                            selected="@(product.Selected ? "selected" : null)">

                                        @product.Text

                                    </option>

                                }



                            </select>





                            <button type="submit"
                                    class="btn btn-primary">


                                <i class="bi bi-images"></i>

                                View Pictures


                            </button>





                            @if (Model.SelectedProductId > 0)
                            {

                                <a asp-action="Create"
                                   asp-route-productId="@Model.SelectedProductId"
                                   class="btn btn-success">


                                    <i class="bi bi-plus-circle"></i>

                                    Add Picture


                                </a>

                            }

                            else
                            {

                                <button type="button"
                                        class="btn btn-success"
                                        disabled>


                                    <i class="bi bi-plus-circle"></i>

                                    Add Picture


                                </button>

                            }



                        </div>


                    </form>


                </div>


            </div>







            @if (Model.Images != null && Model.Images.Any())
            {


                <div class="row g-4">


                    @foreach (var item in Model.Images)
                    {


                        <div class="col-xl-3 col-lg-4 col-md-6">


                            <div class="image-card">


                                <img src="~/images/products/@item.ImageName"
                                     asp-append-version="true"
                                     class="product-image"
                                     alt="@item.ImageName" />




                                <div class="p-3">


                                    <h6 class="image-name"
                                        title="@item.ImageName">

                                        @item.ImageName

                                    </h6>





                                    <div class="mb-3">


                                        <span class="badge bg-primary">

                                            Product ID:
                                            @item.ProductId

                                        </span>


                                        <span class="badge bg-secondary">

                                            Serial:
                                            @item.Serial

                                        </span>


                                    </div>







                                    <div class="d-flex justify-content-between">





                                        <a href="~/images/products/@item.ImageName"
                                           target="_blank"
                                           class="btn btn-primary btn-sm">

                                            <i class="bi bi-eye"></i>

                                        </a>







                                        <a asp-action="Create"
                                           asp-route-productId="@item.ProductId"
                                           class="btn btn-success btn-sm">


                                            <i class="bi bi-plus-lg"></i>


                                        </a>








                                        <form asp-action="Delete"
                                              asp-route-id="@item.Id"
                                              method="post">


                                            @Html.AntiForgeryToken()


                                            <button type="submit"
                                                    class="btn btn-danger btn-sm"
                                                    onclick="return confirm('Delete this image?');">


                                                <i class="bi bi-trash"></i>


                                            </button>


                                        </form>




                                    </div>



                                </div>



                            </div>


                        </div>



                    }


                </div>


            }

            else
            {


                <div class="text-center py-5">


                    <i class="bi bi-image display-1 text-secondary"></i>


                    <h4 class="mt-3 text-muted">

                        Select a product to view images

                    </h4>


                </div>


            }




        </div>


    </div>


</div>